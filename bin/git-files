#!/bin/sh

BAT_THEMES_DIR="$(bat --config-dir)/themes"
mkdir -p "$BAT_THEMES_DIR"

if [ ! -f "$BAT_THEMES_DIR/kanagawa.tmTheme" ]; then
    KANAGAWA_THEME_RAW_URL="https://raw.githubusercontent.com/rebelot/kanagawa.nvim/refs/heads/master/extras/tmTheme/kanagawa.tmTheme"
    curl -Ls --output-dir "$BAT_THEMES_DIR" \
        --output "kanagawa.tmTheme" \
        "$KANAGAWA_THEME_RAW_URL"
fi

if ! bat --list-themes | grep kanagawa >/dev/null; then
    bat cache --build >/dev/null 2>&1
fi

BAT_THEME="${BAT_THEME:-kanagawa}"
BAT_STYLE="${BAT_STYLE:-changes,numbers}"
FZF_GIT_FILES_DEFAULT_OPTS="${FZF_GIT_FILES_DEFAULT_OPTS:---border=rounded --border-label=' git-files '}"
FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS-} ${FZF_GIT_FILES_DEFAULT_OPTS-} --bind='focus:transform-preview-label:basename {}'"

GIT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"

EXIT_CODE=$?
[ $EXIT_CODE -ne 0 ] && exit 1

GIT_FILES="$(git ls-files "$GIT_DIR" --modified --others)"

[ -z "$GIT_FILES" ] && exit 1

SELECTED_FILE="$(echo "$GIT_FILES" | FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS-}" BAT_STYLE="${BAT_STYLE-}" BAT_THEME="${BAT_THEME-}" fzf --preview="bat --style=numbers,changes,grid --color=always {}")"
[ -n "$SELECTED_FILE" ] && "$EDITOR" "$SELECTED_FILE"
